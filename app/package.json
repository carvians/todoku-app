{
  "name": "todoku-api",
  "version": "2.0.0",
  "description": "TodoKu - REST API aplikasi manajemen tugas multi-user (Express + PostgreSQL)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate-cli.js",
    "test": "jest --runInBand --coverage",
    "test:unit": "jest --runInBand tests/unit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
