# Salin menjadi .env lalu ubah nilainya:  cp .env.example .env
# JANGAN commit file .env ke Git.

# ---- Database ----
POSTGRES_DB=todoku
POSTGRES_USER=todoku
POSTGRES_PASSWORD=ganti_dengan_password_kuat

# ---- Aplikasi ----
# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
MAX_UPLOAD_MB=5
WEB_PORT=8080

# ---- Khusus produksi (docker-compose.prod.yml) ----
REGISTRY=ghcr.io
IMAGE_NAMESPACE=username-github-anda
IMAGE_TAG=latest
