# Konfigurasi Nginx TodoKu (diproses envsubst saat container start)

upstream todoku_api {
    server ${API_UPSTREAM};
    keepalive 16;
}

# Batas laju request API per IP (lapisan perlindungan tambahan)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-App-Version ${APP_VERSION} always;

    # Healthcheck Nginx sendiri (tidak bergantung pada backend)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Reverse proxy ke container backend
    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://todoku_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_request_buffering off;
    }

    # File statis CSS/JS di-cache singkat agar update deploy cepat terlihat
    location ~* \.(css|js|svg|png|ico)$ {
        expires 1h;
        try_files $uri =404;
    }

    # index.html tidak di-cache (expires -1 => Cache-Control: no-cache).
    # Catatan: sengaja tidak memakai add_header di dalam location agar
    # header keamanan di level server tetap diwariskan.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
